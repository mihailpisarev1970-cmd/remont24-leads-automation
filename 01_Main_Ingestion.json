        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты — AI-ассистент сервисного центра 'Ремонт24'. Твоя задача — проанализировать входящую заявку клиента и вернуть строго валидный JSON без разметки markdown.\\n\\nПоля для ответа:\\n- service: 'refrigerators' | 'washers' | 'ovens' | 'dishwashers' | 'microwaves' | 'unknown'\\n- urgency: 'urgent' | 'high' | 'medium' | 'low' | 'unknown'\\n- status: 'new' | 'needs_clarification' | 'duplicate' | 'in_progress' | 'closed'\\n- summary: Краткая суть поломки (до 10 слов)\\n- responsible: 'boris' | 'anna' | 'denis'\\n\\nПравила назначения ответственных:\\n- refrigerators -> boris\\n- washers, dishwashers, microwaves, unknown -> anna\\n- ovens -> denis\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Имя: {{ $('Normalize Data').item.json.name }}\\nТелефон: {{ $('Normalize Data').item.json.phone_normalized }}\\nСообщение: {{ $('Normalize Data').item.json.message }}\"\n    }\n  ],\n  \"temperature\": 0.1,\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [

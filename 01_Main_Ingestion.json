    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Получаем ответ от Polza AI\nconst aiContent = $json.choices[0].message.content;\n\n// Парсим JSON из ответа нейросети\nlet parsed = {};\ntry {\n  parsed = typeof aiContent === 'string' ? JSON.parse(aiContent) : aiContent;\n} catch (e) {\n  parsed = {\n    service: 'unknown',\n    urgency: 'unknown',\n    status: 'needs_clarification',\n    responsible: 'anna',\n    summary: 'Ошибка парсинга ответа AI'\n  };\n}\n\n// Берем исходные данные лида из ноды Normalize Data\nconst normalizedData = $('Normalize Data').item.json;\n\nreturn {\n  json: {\n    event_id: normalizedData.event_id,\n    name: normalizedData.name,\n    phone: normalizedData.phone,\n    phone_normalized: normalizedData.phone_normalized,\n    telegram_id: normalizedData.telegram_id,\n    sources: normalizedData.source,\n    raw_messages: normalizedData.message,\n    service: parsed.service || 'unknown',\n    urgency: parsed.urgency || 'unknown',\n    status: parsed.status || 'new',\n    responsible: parsed.responsible || 'anna',\n    Notes: parsed.summary || ''\n  }\n};"
      },

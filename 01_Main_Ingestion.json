    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Функция нормализации телефона до международного формата E.164 (+7XXXXXXXXXX)\nfunction normalizePhone(phone) {\n  if (!phone) return null;\n  let digits = String(phone).replace(/\\D/g, ''); // Оставляем только цифры\n  \n  if (digits.length === 11 && digits.startsWith('8')) {\n    digits = '7' + digits.slice(1);\n  } else if (digits.length === 10) {\n    digits = '7' + digits;\n  }\n  \n  return digits.length === 11 ? '+' + digits : null;\n}\n\nconst input = $input.item.json;\nconst body = input.body || input;\n\n// Извлекаем все необходимые поля по спецификации ТЗ\nconst event_id = body.event_id || null;\nconst source = body.source || 'website';\nconst external_user_id = body.external_user_id || null;\nconst received_at = body.received_at || new Date().toISOString();\nconst name = body.name || 'Клиент';\nconst raw_phone = body.phone || null;\nconst phone_normalized = normalizePhone(raw_phone);\nconst telegram_id = body.telegram_id || null;\nconst message = body.message || '';\n\nreturn {\n  json: {\n    event_id,\n    source,\n    external_user_id,\n    received_at,\n    name,\n    phone: raw_phone,\n    phone_normalized,\n    telegram_id,\n    message\n  }\n};"
      },
